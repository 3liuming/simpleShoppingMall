<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itheima.simpleShoppingMallDemo.Mapper.UserMapper">

    <select id="selUserByName" resultType="java.lang.Integer">
        SELECT username FROM Users WHERE username = #{username}
    </select>

    <select id="selUserByNameAndPwd" parameterType="user" resultType="java.lang.Integer">
        SELECT username,password FROM Users WHERE username = #{username} and password = #{password}
    </select>

    <insert id="regUserByNameAndPwd" parameterType="user">
        INSERT INTO users (username, password)
        VALUES (#{username},#{password})
    </insert>
</mapper>